# Configuración de ReparsoftCliente — PLANTILLA
# Copiar como config.properties y completar los valores reales.
# config.properties NO está versionado (contiene credenciales).

# --- MySQL Principal (Reparaciones) ---
# Usuario de aplicación: reparsoft_app@localhost (ver sql/crear_usuario_reparsoft.sql)
db.host=localhost
db.port=3306
db.user=reparsoft_app
db.password=COMPLETAR
db.options=useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true

# --- SMTP (EnviarMail) ---
smtp.host=smtp.gmail.com
smtp.port=587
smtp.user=COMPLETAR
smtp.password=COMPLETAR
smtp.protocol=smtp
smtp.auth=true
smtp.starttls.enable=true

# --- Clever Cloud (Backup remoto) ---
clever.brc.host=COMPLETAR
clever.brc.port=3306
clever.brc.database=COMPLETAR
clever.brc.user=COMPLETAR
clever.brc.password=COMPLETAR
clever.bsas.host=COMPLETAR
clever.bsas.port=3306
clever.bsas.database=COMPLETAR
clever.bsas.user=COMPLETAR
clever.bsas.password=COMPLETAR

# --- FacturaSoft (sync clientes) ---
facturasoft.brc.host=localhost
facturasoft.brc.port=3306
facturasoft.brc.database=facturacion_db_brc
facturasoft.brc.user=reparsoft_app
facturasoft.brc.password=COMPLETAR
facturasoft.bsas.host=localhost
facturasoft.bsas.port=3306
facturasoft.bsas.database=facturacion_db_bsas
facturasoft.bsas.user=reparsoft_app
facturasoft.bsas.password=COMPLETAR

# --- Migración (VentanaMigracion) ---
migracion.staging.host=localhost
migracion.staging.port=3306
migracion.staging.database=reparsoft_staging
migracion.staging.user=reparsoft_app
migracion.staging.password=COMPLETAR
migracion.destino.host=localhost
migracion.destino.port=3306
migracion.destino.user=reparsoft_app
migracion.destino.password=COMPLETAR

# --- Rutas de archivos ---
files.backup.local.path=F:/els/backup
files.pdf.facturas.path=F:/Trabajo/Monotributo/Facturas
files.excel.export.path=F:/els/export

# --- Seguridad ---
security.codigo.acceso=0000
