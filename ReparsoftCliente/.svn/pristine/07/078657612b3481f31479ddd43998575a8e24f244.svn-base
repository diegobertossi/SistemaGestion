package dto;

public class SucursalDTO 
{
	private int IdSucursal;
	private String NombreSucursal;
	private int idClientesuc;
	private String DomicilioSucursal;
	private String ContactoSucursal;
	private String TelefonoSucursal;
	private String CorreoElectronico;
	

	public SucursalDTO(int IdSucursal, String NombreSucursal,int idClienteSuc, String DomicilioSucursal, String ContactoSucursal,String TelefonoSucursal, String CorreoElectronico)
	{
		this.IdSucursal = IdSucursal;
		this.NombreSucursal = NombreSucursal;
		this.idClientesuc= idClienteSuc;
		this.DomicilioSucursal=DomicilioSucursal;
		this.ContactoSucursal= ContactoSucursal;
		this.TelefonoSucursal=TelefonoSucursal;
		this.CorreoElectronico= CorreoElectronico;		
	
	}


	public SucursalDTO(String NombreSucursal) {
		this.NombreSucursal = NombreSucursal;
	}


	public int getIdSucursal() {
		return IdSucursal;
	}


	public void setIdSucursal(int idSucursal) {
		IdSucursal = idSucursal;
	}


	public String getNombreSucursal() {
		return NombreSucursal;
	}


	public void setNombreSucursal(String nombreSucursal) {
		NombreSucursal = nombreSucursal;
	}


	public int getIdClientesuc() {
		return idClientesuc;
	}


	public void setIdClientesuc(int idClientesuc) {
		this.idClientesuc = idClientesuc;
	}


	public String getDomicilioSucursal() {
		return DomicilioSucursal;
	}


	public void setDomicilioSucursal(String domicilioSucursal) {
		DomicilioSucursal = domicilioSucursal;
	}


	public String getContactoSucursal() {
		return ContactoSucursal;
	}


	public void setContactoSucursal(String contactoSucursal) {
		ContactoSucursal = contactoSucursal;
	}


	public String getTelefonoSucursal() {
		return TelefonoSucursal;
	}


	public void setTelefonoSucursal(String telefonoSucursal) {
		TelefonoSucursal = telefonoSucursal;
	}


	public String getCorreoElectronico() {
		return CorreoElectronico;
	}


	public void setCorreoElectronico(String correoElectronico) {
		CorreoElectronico = correoElectronico;
	}

	public String toString(){
		return this.NombreSucursal;
		
	}

}
