package dto;

public class PantallaDTO {

	
	private Integer idPantalla;
	private Integer idPantPadre;
	private String nombre;
	
	public PantallaDTO(Integer idPantalla,Integer idPantPadre, String nombre )
	{
		this.idPantalla = idPantalla;
		this.idPantPadre = idPantPadre;
		this.nombre = nombre;
	}

	public Integer getIdPantalla() {
		return idPantalla;
	}

	public Integer getIdPantPadre() {
		return idPantPadre;
	}

	public String getNombre() {
		return nombre;
	}
	
	
}
