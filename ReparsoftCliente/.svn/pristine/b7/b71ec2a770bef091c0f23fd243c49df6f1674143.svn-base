package dto;

public class RepuestosDTO 
{
	private int ELS;
	private String ref;
	private String original;
	private String reemplazo;
	private String notas;
	private int idRepuesto;
	

	public RepuestosDTO(int ELS, String ref,String original,String reemplazo, String notas)
	{
		this.ELS = ELS;
		this.ref = ref;
		this.original= original;
		this.reemplazo=reemplazo;
		this.notas= notas;

	}
	
	public RepuestosDTO(int idRepuesto, int ELS, String ref,String original,String reemplazo, String notas)
	{
		this.idRepuesto = idRepuesto;
		this.ELS = ELS;
		this.ref = ref;
		this.original= original;
		this.reemplazo=reemplazo;
		this.notas= notas;

	}


	public RepuestosDTO(String original) {
		
		this.original=original;
	}

	public int getELS() {
		return ELS;
	}


	public void setELS(int eLS) {
		ELS = eLS;
	}


	public String getRef() {
		return ref;
	}


	public void setRef(String ref) {
		this.ref = ref;
	}


	public String getOriginal() {
		return original;
	}


	public void setOriginal(String original) {
		this.original = original;
	}


	public String getReemplazo() {
		return reemplazo;
	}


	public void setReemplazo(String reemplazo) {
		this.reemplazo = reemplazo;
	}


	public String getNotas() {
		return notas;
	}


	public void setNotas(String notas) {
		this.notas = notas;
	}

	public int getIdRepuesto() {
		return idRepuesto;
	}

	public void setIdRepuesto(int idRepuesto) {
		this.idRepuesto = idRepuesto;
	}
	
	
	public String toString(){
		return this.reemplazo;
		
	}

	

}
